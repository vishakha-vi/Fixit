# FixIt Environment Configuration Example
# Copy to .env for local customization

# Secret key for cryptographic signing (required in production; generates dev default when empty in DEBUG=True)
SECRET_KEY=change-me-in-production-use-a-strong-secret-key-at-least-50-chars

# Debug mode: True for development, False for production
DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database URL (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Demo Mode toggle: enables clock manipulation and reset_demo command
DEMO_MODE=False

# Password assigned to generated demo users during reset_demo
DEMO_PASSWORD=DemoFixItPass123!

# Application release version (defaults to git short SHA or release tag)
APP_VERSION=1.0.0-dev

# Main admin account created by `python manage.py setup_site` / `ensure_admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=FixIt Admin

# Students may register themselves at /accounts/signup/ (staff & workers are created by admins)
ALLOW_STUDENT_SIGNUP=True

# Optional SMTP for reminder emails (leave EMAIL_HOST empty for in-app reminders only)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FixIt <no-reply@example.edu>
